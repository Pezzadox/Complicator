{
  "appId": "com.thecomplicator.app",
  "appName": "The Complicator",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "includePlugins": [
      "@capacitor/haptics",
      "@capacitor/splash-screen"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#23262B",
      "showSpinner": false
    }
  }
}
